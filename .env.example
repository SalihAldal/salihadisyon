NODE_ENV=development
# PRODUCTION: Asagidaki JWT secret'lari mutlaka guclu ve benzersiz degerlerle degistirin.
# change-me-access / change-me-refresh production'da API baslatmayi engeller.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/adisyon?schema=public
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# API port — sadece apps/api icin. Admin (:3000) ve POS (:3001) ayri port kullanir.
# PORT=4100 apps/api/.env dosyasinda tanimlanir; burada tanimlamayin (admin port cakismasini onler).
NEXT_PUBLIC_APP_NAME=Adisyon SaaS Platform
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4100/pos
NEXT_PUBLIC_POS_WEB_URL=http://localhost:3001
APP_ENV=local
API_CURRENT_VERSION=v1
API_SUPPORTED_VERSIONS=v1,v2
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adisyon
BACKUP_STORAGE_DIR=storage/backups
# Windows + Docker Postgres: host'ta pg_dump yoksa otomatik docker exec fallback
PG_DOCKER_CONTAINER=adisyon-postgres
PG_DOCKER_ENABLED=true
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
# Prisma connection pool (singleton client)
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_TOKEN=
MONITORING_ALERT_EMAIL_ENDPOINT=
MONITORING_ALERT_EMAIL_TOKEN=
MONITORING_ALERT_EMAIL_TO=
MONITORING_ALERT_STATUS_CODES=500,502,503,504
MONITORING_ALERT_ERROR_CODES=INTERNAL_ERROR
MONITORING_ALERT_DEDUP_MS=300000
