{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@adisyon/config": ["packages/config/src/index.ts"],
      "@adisyon/config/*": ["packages/config/src/*"],
      "@adisyon/types": ["packages/types/src/index.ts"],
      "@adisyon/types/*": ["packages/types/src/*"],
      "@adisyon/utils": ["packages/utils/src/index.ts"],
      "@adisyon/utils/*": ["packages/utils/src/*"],
      "@adisyon/ui": ["packages/ui/src/index.ts"],
      "@adisyon/ui/*": ["packages/ui/src/*"]
    }
  }
}
