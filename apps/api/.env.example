NODE_ENV=development
APP_ENV=local
API_CURRENT_VERSION=v1
API_SUPPORTED_VERSIONS=v1,v2
PORT=4100
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/adisyon?schema=public
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
POS_WEB_URL=https://pos.example.com
BACKUP_STORAGE_DIR=storage/backups
PG_DOCKER_CONTAINER=adisyon-postgres
PG_DOCKER_ENABLED=true
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_TOKEN=
MONITORING_ALERT_EMAIL_ENDPOINT=
MONITORING_ALERT_EMAIL_TOKEN=
MONITORING_ALERT_EMAIL_TO=
MONITORING_ALERT_STATUS_CODES=500,502,503,504
MONITORING_ALERT_ERROR_CODES=INTERNAL_ERROR
MONITORING_ALERT_DEDUP_MS=300000
# local/dev: login rate limit kapali (QA icin). Production'da otomatik acik.
AUTH_LOGIN_RATE_LIMIT_ENABLED=false
