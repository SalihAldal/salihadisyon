{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true,
    "outDir": "./dist"
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
