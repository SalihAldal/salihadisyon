  createdAt     DateTime @default(now())

  @@index([companyId, branchId, createdAt])
}

model RefreshTokenSession {
  id              String   @id @default(cuid())
  companyId       String
  userId          String
  deviceLabel     String?
  refreshTokenHash String
  userAgent       String?
  ipAddress       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([companyId, userId, expiresAt])
  @@index([userId, revokedAt])
}

model SystemBackup {
  id                  String              @id @default(cuid())
  trigger             SystemBackupTrigger @default(MANUAL)
  status              SystemBackupStatus  @default(RUNNING)
  requestedByUserId   String?
  label               String?
  fileName            String?
  filePath            String?
  checksumSha256      String?
  sizeBytes           BigInt?
  databaseName        String?
  criticalSummary     Json?
  manifest            Json?
  restoreSourceBackupId String?
  errorMessage        String?
  startedAt           DateTime            @default(now())
  finishedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([trigger, createdAt])
  @@index([requestedByUserId, createdAt])
}
