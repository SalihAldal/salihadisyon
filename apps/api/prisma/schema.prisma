generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PASSIVE
  SUSPENDED
}

enum TicketChannel {
  TABLE
  SELF_SERVICE
  DELIVERY
  TAKEAWAY
  QR_MENU
}

enum TicketStatus {
  DRAFT
  OPEN
  PREPARING
  SERVED
  PAYMENT_PENDING
  PAID
  CANCELLED
  VOIDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  MEAL_CARD
  GIFT_CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum PosConnectionType {
  NETWORK
  USB
}

enum PosDeviceHealthStatus {
  IDLE
  OFFLINE
  ONLINE
  ERROR
  BUSY
}

enum PosTransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum AttendanceAction {
  SHIFT_IN
  SHIFT_OUT
  BREAK_START
  BREAK_END
}

enum ShiftType {
  WORK
  LEAVE
  OFF_DAY
}

enum CampaignType {
  PRODUCT
  CATEGORY
  CART
  HAPPY_HOUR
  TIMED
  BUY_X_PAY_Y
  BUY_ONE_GET_ONE
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
  FIXED_PRICE
}

enum NotificationType {
  STOCK_ALERT
  CASH_CLOSURE
  ATTENDANCE
  APPROVAL
  TASK
  SYSTEM
}

enum EmployeePaymentMovementType {
  PAYMENT
  RECEIVABLE
}

enum SystemBackupTrigger {
  MANUAL
  DAILY_AUTO
  PRE_RESTORE
}

enum SystemBackupStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum MonitoringSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model Company {
  id                String             @id @default(cuid())
  name              String
  legalName         String?
  taxNumber         String?
  subscriptionState SubscriptionStatus @default(TRIAL)
  timezone          String             @default("Europe/Istanbul")
  currency          String             @default("TRY")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  branches          Branch[]
  users             User[]
  employeeProfiles  EmployeeProfile[]
  roles             Role[]
  customers         Customer[]
  suppliers         Supplier[]
  productRatings    ProductRating[]
  staffDiscounts    StaffDiscount[]
  supportTickets    SupportTicket[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  refreshSessions   RefreshTokenSession[]
}

model Branch {
  id                 String                 @id @default(cuid())
  companyId          String
  name               String
  code               String
  city               String?
  district           String?
  addressLine        String?
  phone              String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  company            Company                @relation(fields: [companyId], references: [id])
  users              User[]
  userRoles          UserRole[]
  terminals          Terminal[]
  printers           Printer[]
  posDevices         PosDevice[]
  posDeviceAssignments PosDeviceAssignment[]
  posDeviceTransactions PosDeviceTransaction[]
  posDeviceLogs      PosDeviceLog[]
  paymentMethods     PaymentMethodConfig[]
  menuCategories     MenuCategory[]
  menuProducts       MenuProduct[]
  productBranchPrices ProductBranchPrice[]
  qrMenuSettings     QrMenuSetting[]
  tableAreas         TableArea[]
  diningTables       DiningTable[]
  tableColorRules    TableColorRule[]
  tickets            Ticket[]
  campaigns          Campaign[]
  customers          Customer[]
  discountTypeConfigs DiscountTypeConfig[]
  presetNotes        PresetNote[]
  posSettings        PosSetting[]
  backScreenSlides   BackScreenSlide[]
  employeeProfiles   EmployeeProfile[]
  goals              Goal[]
  goalBonuses        GoalBonus[]
  shifts             Shift[]
  attendanceQrTokens AttendanceQrToken[]
  attendanceEvents   AttendanceEvent[]
  auditSurveys       OperationalAuditSurvey[]
  auditQuestions     OperationalAuditQuestion[]
  accounts           Account[]
  ledgerEntries      LedgerEntry[]
  invoices           Invoice[]
  expenses           Expense[]
  registerClosings   RegisterClosing[]
  registerTransactions RegisterTransaction[]
  payrollPayments    PayrollPayment[]
  otherPayments      OtherPayment[]
  warehouses         Warehouse[]
  notifications      Notification[]
  tasks              Task[]
  stockAlerts        StockAlert[]
  cashClosures       CashClosure[]
  integrationCreds   IntegrationCredential[]
  productRatings     ProductRating[]
  staffDiscounts     StaffDiscount[]
  supportTickets     SupportTicket[]

  @@unique([companyId, code])
  @@index([companyId])
}

model User {
  id              String       @id @default(cuid())
  companyId       String
  defaultBranchId String?
  fullName        String
  firstName       String?
  lastName        String?
  email           String       @unique
  phone           String?
  passwordHash    String
  isActive        Boolean      @default(true)
  twoFactorSecret String?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  company         Company      @relation(fields: [companyId], references: [id])
  defaultBranch   Branch?      @relation(fields: [defaultBranchId], references: [id])
  roles           UserRole[]
  employeeProfiles EmployeeProfile[]
  openedTickets   Ticket[]     @relation("OpenedTickets")
  registerClosings RegisterClosing[]
  registerTransactions RegisterTransaction[]
  createdExpenses Expense[]   @relation("CreatedExpenses")
  devices         Device[]
  assignedTasks   Task[]       @relation("AssignedTasks")
  createdTasks    Task[]       @relation("CreatedTasks")
  notifications   Notification[]
  assignedAuditSurveys OperationalAuditSurvey[]
  auditLogs       AuditLog[]
  createdEmployeeStatusLogs EmployeeStatusLog[] @relation("EmployeeStatusLogCreatedBy")
  refreshSessions RefreshTokenSession[]

  @@index([companyId])
  @@index([defaultBranchId])
}

model Role {
  id          String           @id @default(cuid())
  companyId   String
  key         String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id])
  users       UserRole[]
  permissions RolePermission[]
  primaryEmployees EmployeeProfile[] @relation("EmployeePrimaryRole")

  @@unique([companyId, key])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId     String
  roleId     String
  branchId   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  branch     Branch?  @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
  @@index([branchId])
}

model Device {
  id          String   @id @default(cuid())
  userId       String
  deviceType   String
  platform     String
  pushToken    String?
  fingerprint  String?
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Terminal {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  code        String
  ipAddress   String?
  status      String   @default("offline")
  heartbeatAt DateTime?
  branch      Branch   @relation(fields: [branchId], references: [id])
  posAssignments PosDeviceAssignment[]
  posTransactions PosDeviceTransaction[]
  registerClosings RegisterClosing[]

  @@unique([branchId, code])
}

model Printer {
  id           String   @id @default(cuid())
  branchId      String
  name          String
  type          String
  connectionUri String
  isKitchen     Boolean  @default(false)
  branch        Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model PosDevice {
  id          String   @id @default(cuid())
  branchId     String
  name         String
  code         String
  deviceType   String
  platform     String?
  ipAddress    String?
  status       String   @default("inactive")
  isActive     Boolean  @default(true)
  lastSeenAt   DateTime?
  brand        String?
  model        String?
  serialNumber String?
  registryNumber String?
  connectionType PosConnectionType?
  port         Int?
  pinCodeEnc   String?
  deviceIdentifier String?
  capabilitiesJson Json?
  settingsJson Json?
  lastTestedAt DateTime?
  lastTestStatus String?
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id])
  assignments  PosDeviceAssignment[]
  transactions PosDeviceTransaction[]
  logs         PosDeviceLog[]

  @@unique([branchId, code])
  @@index([branchId, status])
  @@index([branchId, serialNumber, isActive])
}

model PosDeviceAssignment {
  id             String   @id @default(cuid())
  posDeviceId    String
  branchId       String
  terminalId     String?
  cashRegisterId String?
  stationId      String?
  assignedUserId String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  posDevice      PosDevice @relation(fields: [posDeviceId], references: [id])
  branch         Branch    @relation(fields: [branchId], references: [id])
  terminal       Terminal? @relation(fields: [terminalId], references: [id])

  @@index([branchId, terminalId, isDefault])
  @@index([posDeviceId, isActive])
}

model PosDeviceTransaction {
  id                 String   @id @default(cuid())
  posDeviceId        String
  branchId           String
  terminalId         String?
  ticketId           String?
  transactionType    String
  amount             Decimal  @db.Decimal(12, 2)
  currency           String   @default("TRY")
  installmentCount   Int?
  referenceNo        String?
  stanNo             String?
  rrnNo              String?
  batchNo            String?
  authCode           String?
  maskedCardNo       String?
  cardBrand          String?
  responseCode       String?
  responseMessage    String?
  providerStatus     String?
  providerPayloadJson Json?
  requestPayloadJson Json?
  status             PosTransactionStatus @default(PENDING)
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  posDevice          PosDevice @relation(fields: [posDeviceId], references: [id])
  branch             Branch    @relation(fields: [branchId], references: [id])
  terminal           Terminal? @relation(fields: [terminalId], references: [id])
  ticket             Ticket?   @relation(fields: [ticketId], references: [id])

  @@index([branchId, status, createdAt])
  @@index([ticketId, createdAt])
  @@index([posDeviceId, createdAt])
}

model PosDeviceLog {
  id          String   @id @default(cuid())
  posDeviceId String
  branchId    String
  level       String
  eventType   String
  message     String
  contextJson Json?
  createdAt   DateTime @default(now())
  posDevice   PosDevice @relation(fields: [posDeviceId], references: [id])
  branch      Branch    @relation(fields: [branchId], references: [id])

  @@index([posDeviceId, createdAt])
  @@index([branchId, createdAt])
}

model PosBrandModel {
  id                           String   @id @default(cuid())
  brand                        String
  model                        String
  supportedConnectionTypesJson Json?
  requiresIp                   Boolean  @default(false)
  requiresPort                 Boolean  @default(false)
  requiresPin                  Boolean  @default(false)
  isActive                     Boolean  @default(true)
  capabilitiesJson             Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([brand, model])
  @@index([brand, isActive])
}

model PaymentMethodConfig {
  id            String   @id @default(cuid())
  companyId      String
  branchId       String?
  name           String
  code           String
  providerKey    String?
  paymentMethod  PaymentMethod
  feeRate        Decimal? @db.Decimal(5, 2)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  settingsJson   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId, branchId])
  @@unique([companyId, code])
}

model Customer {
  id            String            @id @default(cuid())
  companyId      String
  branchId       String?
  customerType   String            @default("individual")
  fullName       String
  businessName   String?
  phone          String?
  email          String?
  taxNumber      String?
  taxOffice      String?
  billingAddress String?
  birthDate      DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  company        Company           @relation(fields: [companyId], references: [id])
  branch         Branch?           @relation(fields: [branchId], references: [id])
  addresses      CustomerAddress[]
  tickets        Ticket[]
  vatReports     CustomerVatReport[]
  productRatings ProductRating[]

  @@index([companyId, branchId])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  title        String
  city         String?
  district     String?
  addressLine  String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  customer     Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model MenuCategory {
  id           String         @id @default(cuid())
  companyId     String
  branchId      String?
  parentId      String?
  defaultVatRateId String?
  name          String
  slug          String
  printerType   String         @default("kitchen")
  sortOrder     Int            @default(0)
  isVisible     Boolean        @default(true)
  showInQr      Boolean        @default(true)
  branch        Branch?        @relation(fields: [branchId], references: [id])
  parent        MenuCategory?  @relation("MenuCategoryTree", fields: [parentId], references: [id])
  children      MenuCategory[] @relation("MenuCategoryTree")
  defaultVatRate VatRate?      @relation("CategoryDefaultVatRate", fields: [defaultVatRateId], references: [id])
  products      MenuProduct[]
  goals         Goal[]

  @@index([companyId, branchId])
}

model MenuProduct {
  id                String            @id @default(cuid())
  companyId          String
  branchId           String?
  categoryId         String
  sku                String?
  name               String
  slug               String
  description        String?
  imageUrl           String?
  basePrice          Decimal           @db.Decimal(10, 2)
  vatRateId          String?
  isVatAuto          Boolean           @default(false)
  isActive           Boolean           @default(true)
  isVisible          Boolean           @default(true)
  showInQr           Boolean           @default(true)
  visibilityChannels Json?
  stockItemId        String?
  calories           Int?
  allergenInfo       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  branch             Branch?           @relation(fields: [branchId], references: [id])
  category           MenuCategory      @relation(fields: [categoryId], references: [id])
  vatRate            VatRate?          @relation(fields: [vatRateId], references: [id])
  stockItem          InventoryItem?    @relation("MenuProductStockItem", fields: [stockItemId], references: [id])
  variants           ProductVariant[]
  branchPrices       ProductBranchPrice[]
  ticketItems        TicketItem[]
  unitCosts          UnitCost[]
  recipe             Recipe?
  ratings            ProductRating[]
  goals              Goal[]

  @@index([companyId, branchId, categoryId])
  @@index([stockItemId])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId    String
  name         String
  priceDiff    Decimal     @default(0) @db.Decimal(10, 2)
  sortOrder    Int         @default(0)
  product      MenuProduct @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductBranchPrice {
  id         String      @id @default(cuid())
  productId   String
  branchId    String
  price       Decimal     @db.Decimal(10, 2)
  startsAt    DateTime?
  product     MenuProduct @relation(fields: [productId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
}

model ModifierGroup {
  id          String           @id @default(cuid())
  companyId    String
  name         String
  selectionMin Int              @default(0)
  selectionMax Int              @default(10)
  options      ModifierOption[]

  @@index([companyId])
}

model ModifierOption {
  id           String        @id @default(cuid())
  groupId       String
  name          String
  priceDiff     Decimal       @default(0) @db.Decimal(10, 2)
  inventoryItemId String?
  stockQuantity Decimal?      @db.Decimal(10, 2)
  sortOrder     Int           @default(0)
  group         ModifierGroup @relation(fields: [groupId], references: [id])
  inventoryItem InventoryItem? @relation("ModifierOptionStockItem", fields: [inventoryItemId], references: [id])

  @@index([groupId])
  @@index([inventoryItemId])
}

model RequiredChoiceGroup {
  id           String                 @id @default(cuid())
  companyId     String
  name          String
  selectionMin  Int                    @default(1)
  selectionMax  Int                    @default(1)
  options       RequiredChoiceOption[]

  @@index([companyId])
}

model RequiredChoiceOption {
  id         String               @id @default(cuid())
  groupId     String
  name        String
  priceDiff   Decimal              @default(0) @db.Decimal(10, 2)
  inventoryItemId String?
  stockQuantity Decimal?           @db.Decimal(10, 2)
  group       RequiredChoiceGroup  @relation(fields: [groupId], references: [id])
  inventoryItem InventoryItem?     @relation("RequiredChoiceOptionStockItem", fields: [inventoryItemId], references: [id])

  @@index([groupId])
  @@index([inventoryItemId])
}

model TableArea {
  id         String        @id @default(cuid())
  branchId    String
  name        String
  sortOrder   Int           @default(0)
  branch      Branch        @relation(fields: [branchId], references: [id])
  tables      DiningTable[]

  @@index([branchId])
}

model DiningTable {
  id            String      @id @default(cuid())
  branchId       String
  areaId         String?
  code           String
  name           String
  colorHex       String?
  capacity       Int         @default(2)
  status         TableStatus @default(AVAILABLE)
  activeTicketId String?
  branch         Branch      @relation(fields: [branchId], references: [id])
  area           TableArea?  @relation(fields: [areaId], references: [id])
  tickets        Ticket[]

  @@unique([branchId, code])
  @@index([areaId])
}

model Ticket {
  id                 String         @id @default(cuid())
  companyId           String
  branchId            String
  createdByUserId     String?
  customerId          String?
  tableId             String?
  channel             TicketChannel
  status              TicketStatus  @default(OPEN)
  ticketName          String?
  coverCount          Int           @default(1)
  openedAt            DateTime      @default(now())
  closedAt            DateTime?
  subtotal            Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal       @default(0) @db.Decimal(12, 2)
  branch              Branch        @relation(fields: [branchId], references: [id])
  createdByUser       User?         @relation("OpenedTickets", fields: [createdByUserId], references: [id])
  customer            Customer?     @relation(fields: [customerId], references: [id])
  table               DiningTable?  @relation(fields: [tableId], references: [id])
  items               TicketItem[]
  payments            Payment[]
  events              TicketEvent[]
  posTransactions     PosDeviceTransaction[]
  registerTransactions RegisterTransaction[] @relation("RegisterTransactionOrder")

  @@index([companyId, branchId, status])
  @@index([companyId, branchId, status, closedAt])
  @@index([branchId, createdByUserId, closedAt])
}

model TicketItem {
  id           String      @id @default(cuid())
  ticketId      String
  productId     String?
  productName   String
  quantity      Decimal     @db.Decimal(10, 2)
  unitPrice     Decimal     @db.Decimal(10, 2)
  discountTotal Decimal     @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(10, 2)
  lineTotal     Decimal     @db.Decimal(10, 2)
  notes         String?
  modifiersJson Json?
  ticket        Ticket      @relation(fields: [ticketId], references: [id])
  product       MenuProduct? @relation(fields: [productId], references: [id])

  @@index([ticketId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(cuid())
  ticketId        String
  accountId       String?
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  referenceNumber String?
  paidAt          DateTime?
  notes           String?
  ticket          Ticket        @relation(fields: [ticketId], references: [id])
  account         Account?      @relation(fields: [accountId], references: [id])

  @@index([ticketId, status])
  @@index([status, paidAt])
}

model TicketEvent {
  id         String   @id @default(cuid())
  ticketId    String
  type        String
  payload     Json?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}

model Campaign {
  id              String        @id @default(cuid())
  branchId         String
  name             String
  type             CampaignType
  discountType     DiscountType
  priority         Int           @default(0)
  isAutomatic      Boolean       @default(true)
  startsAt         DateTime
  endsAt           DateTime?
  conditionsJson   Json?
  benefitsJson     Json?
  branch           Branch        @relation(fields: [branchId], references: [id])

  @@index([branchId, startsAt, endsAt])
}

model EmployeeProfile {
  id            String   @id @default(cuid())
  companyId      String
  branchId       String
  userId         String?
  employeeCode   String
  attendanceQrHash String? @unique
  attendanceQrIssuedAt DateTime?
  pinCodeEnc     String?
  lateToleranceMinutes Int @default(10)
  department     String?
  title          String?
  restaurantRole String?
  staffRoleId    String?
  hireDate       DateTime?
  birthDate      DateTime?
  salary         Decimal? @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  isOwner        Boolean  @default(false)
  overtimeEnabled Boolean @default(false)
  dailyFreeDrinkLimit Int @default(0)
  totalBreakMinutes Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])
  branch         Branch   @relation(fields: [branchId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
  staffRole      Role?    @relation("EmployeePrimaryRole", fields: [staffRoleId], references: [id])
  shifts         Shift[]
  breaks         BreakRecord[]
  goals          Goal[]
  goalBonuses    GoalBonus[]
  attendanceEvents AttendanceEvent[]
  payrollPayments PayrollPayment[]
  staffDiscounts StaffDiscount[]
  personalProfile EmployeePersonalProfile?
  contactProfile EmployeeContactProfile?
  financialProfile EmployeeFinancialProfile?
  emergencyContact EmployeeEmergencyContact?
  statusLogs     EmployeeStatusLog[]

  @@unique([branchId, employeeCode])
  @@index([branchId, isActive])
  @@index([companyId, branchId, isActive])
  @@index([staffRoleId])
}

model EmployeePersonalProfile {
  id                    String          @id @default(cuid())
  employeeId            String          @unique
  photo                 String?
  nationality           String?
  identityNumberEnc     String?
  identityNumberLast4   String?
  gender                String?
  bloodType             String?
  disabilityStatus      String?
  educationStatus       String?
  highestEducationLevel String?
  lastEducationSchool   String?
  maritalStatus         String?
  childrenCount         Int?
  birthDate             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  employee              EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeContactProfile {
  id         String          @id @default(cuid())
  employeeId String          @unique
  address    String?
  country    String?
  city       String?
  district   String?
  postalCode String?
  homePhone  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeFinancialProfile {
  id                 String          @id @default(cuid())
  employeeId         String          @unique
  salary             Decimal?        @db.Decimal(12, 2)
