  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId, branchId, noteType])
}

model PosSetting {
