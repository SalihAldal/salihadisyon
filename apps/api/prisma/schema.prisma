model ExportJob {
  id            String   @id @default(cuid())
  companyId      String
  branchId       String?
  module         String
  format         String
  filtersJson    Json?
  status         String   @default("queued")
  fileUrl        String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([companyId, branchId, status])
}

model Notification {
  id          String           @id @default(cuid())
  branchId     String
  userId       String?
  type         NotificationType
  title        String
  message      String
  data         Json?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  branch       Branch           @relation(fields: [branchId], references: [id])
  user         User?            @relation(fields: [userId], references: [id])

  @@index([branchId, createdAt])
  @@index([userId, isRead])
}

model OperationalAuditQuestion {
  id            String   @id @default(cuid())
  branchId       String
  question       String
  category       String?
  weight         Int      @default(1)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, category, sortOrder])
}

model OperationalAuditSurvey {
  id             String   @id @default(cuid())
  branchId        String
  assignedToUserId String?
  title          String
  description    String?
  status         String   @default("draft")
  dueAt          DateTime?
  submittedAt    DateTime?
  score          Decimal? @db.Decimal(5, 2)
  answersJson    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch   @relation(fields: [branchId], references: [id])
  assignedToUser User?    @relation(fields: [assignedToUserId], references: [id])

  @@index([branchId, status, dueAt])
}

model FileAsset {
  id            String   @id @default(cuid())
  companyId      String
  branchId       String?
  bucket         String
  objectKey      String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())
}

model BackScreenSlide {
  id            String   @id @default(cuid())
  companyId      String
  branchId       String?
  title          String
  subtitle       String?
  mediaUrl       String
  ctaLabel       String?
  ctaUrl         String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId, branchId, sortOrder])
}

model TableColorRule {
  id            String      @id @default(cuid())
  branchId       String
  name           String
  tableStatus    TableStatus
  colorHex       String
  textColorHex   String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  branch         Branch      @relation(fields: [branchId], references: [id])

  @@index([branchId, tableStatus])
}

model DiscountTypeConfig {
  id               String       @id @default(cuid())
  companyId         String
  branchId          String?
  name              String
  code              String
  discountType      DiscountType
  defaultValue      Decimal?     @db.Decimal(10, 2)
  approvalRequired  Boolean      @default(false)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  branch            Branch?      @relation(fields: [branchId], references: [id])

  @@index([companyId, branchId])
  @@unique([companyId, code])
}

model PresetNote {
  id            String   @id @default(cuid())
  companyId      String
  branchId       String?
  title          String
  content        String
  noteType       String   @default("service")
