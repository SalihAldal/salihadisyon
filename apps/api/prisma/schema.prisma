  companyId      String
  branchId       String?
  key            String
  valueJson      Json
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId, branchId])
  @@unique([companyId, branchId, key])
}

